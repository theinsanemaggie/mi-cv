# Next.js static export genera una página por ruta como archivo .html
# suelto (ej: sobre-mi.html) en vez de sobre-mi/index.html. Esta regla
# hace que /sobre-mi (sin extensión) sirva sobre-mi.html.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html
